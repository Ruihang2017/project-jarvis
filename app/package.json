{
  "name": "edward-app",
  "version": "0.3.0",
  "private": true,
  "description": "Edward desktop app (Electron). The assistant itself is the core in ../src.",
  "type": "module",
  "main": "build/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx scripts/seed.ts",
    "dist": "node scripts/build.mjs && electron-builder --win nsis --publish never",
    "dist:dir": "node scripts/build.mjs && electron-builder --win --dir --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --universal --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "productName": "Edward",
  "author": "Ruihang Hou",
  "build": {
    "appId": "Edward.Assistant",
    "productName": "Edward",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "build/main/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "Edward-${version}-mac.${ext}",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Edward listens when you talk to it with the microphone button."
      }
    },
    "dmg": {
      "title": "Edward ${version}"
    },
    "nsis": {
      "artifactName": "Edward-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edward",
      "uninstallDisplayName": "Edward",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "extraMetadata": {
      "main": "build/main/main.js"
    }
  }
}
