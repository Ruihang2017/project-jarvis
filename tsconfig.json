{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    // Bundler resolution: generated protocol files use extensionless type-only imports.
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"]
}
