{
  "name": "jarvis",
  "version": "0.1.0",
  "description": "Personal CLI chatbot on codex app-server",
  "type": "module",
  "private": true,
  "bin": {
    "jarvis": "dist/index.js"
  },
  "scripts": {
    "prepare": "tsc",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "gen:protocol": "codex app-server generate-ts --experimental --out src/protocol",
    "test": "tsx test/memory-store.test.ts && tsx test/reminders.test.ts && tsx test/background.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
